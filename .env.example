# Copy to .env and replace every placeholder. Never commit .env.

# --- Django ---
DJANGO_DEBUG=true
# Generate: py -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Number of trusted reverse proxies in front of Django (0 in local dev)
DJANGO_NUM_PROXIES=0
# Used to build invitation links
FRONTEND_URL=http://localhost:5173
INVITATION_TTL_HOURS=72

# --- Encryption keys (32 random bytes each, "version:base64url") ---
# Generate: py -c "import base64,os; print('1:' + base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Rotation: append a new version ("1:...,2:...") - the highest version encrypts, all listed versions decrypt.
SV_MFA_ENCRYPTION_KEYS=change-me

# --- Email (password reset). Default writes files to backend/var/mail for local dev. ---
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_DEFAULT_FROM_EMAIL=SecureVault <no-reply@example.com>

# --- PostgreSQL ---
POSTGRES_DB=securevault
POSTGRES_USER=securevault
POSTGRES_PASSWORD=change-me
# localhost when running Django from the venv; docker-compose overrides this to "db"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
# localhost when running from the venv; docker-compose overrides this to redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
