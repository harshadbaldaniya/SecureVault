# Copy to .env and replace every placeholder. Never commit .env.

# --- Django ---
DJANGO_DEBUG=true
# Generate: py -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Number of trusted reverse proxies in front of Django (0 in local dev)
DJANGO_NUM_PROXIES=0
# Used to build invitation links
FRONTEND_URL=http://localhost:5173
INVITATION_TTL_HOURS=72

# --- PostgreSQL ---
POSTGRES_DB=securevault
POSTGRES_USER=securevault
POSTGRES_PASSWORD=change-me
# localhost when running Django from the venv; docker-compose overrides this to "db"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
# localhost when running from the venv; docker-compose overrides this to redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
