# Production configuration template. Copy to `.env.prod` (git-ignored), replace EVERY value, and keep the file
# readable only by the operator. Never commit .env.prod. Used as:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# Generate random values with:  py -c "import secrets; print(secrets.token_urlsafe(48))"
# Generate encryption keys with: py -c "import base64,os; print('1:' + base64.urlsafe_b64encode(os.urandom(32)).decode())"

# --- Public address ---------------------------------------------------------------------------------------------
# The hostname users type, and the exact origin (scheme://host[:port]) the browser sends.
DJANGO_ALLOWED_HOSTS=vault.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://vault.example.com
# Base URL used in invitation and password-reset links.
FRONTEND_URL=https://vault.example.com
# Host ports for the nginx container (80/443 in production; use high ports on a workstation).
SV_HTTP_PORT=80
SV_HTTPS_PORT=443

# --- Django -----------------------------------------------------------------------------------------------------
# At least 50 random characters. Signs sessions and CSRF tokens; changing it signs everyone out.
DJANGO_SECRET_KEY=change-me
INVITATION_TTL_HOURS=72

# --- Database ---------------------------------------------------------------------------------------------------
POSTGRES_DB=securevault
# Three roles, three different passwords:
# 1. Bootstrap superuser, created by the postgres image. Only the database container receives this password; use it
#    for administration (backups, restores), never for the application.
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=change-me
# 2. Owner: owns the tables and runs migrations. Not a superuser. Only the one-shot `migrate` job receives it.
SV_OWNER_DB_USER=securevault_owner
SV_OWNER_DB_PASSWORD=change-me
# 3. Application role: what the web and worker processes connect as. It cannot change the schema or rewrite the
#    audit trail (manage.py apply_db_grants).
SV_APP_DB_USER=securevault_app
SV_APP_DB_PASSWORD=change-me
# Maximum pooled connections per process.
SV_DB_POOL_MAX=10

# --- Redis (throttles, cache, WebSocket fan-out). Use URL-safe characters only (letters, digits, - and _). ----------
REDIS_PASSWORD=change-me

# --- Encryption keys: "version:base64url(32 random bytes)". Three DIFFERENT keys. ---------------------------------------
# Losing the KEK makes every stored credential unrecoverable; leaking it, together with a database copy, exposes them.
# Keep an offline, access-controlled backup (docs/deployment-guide.md). Rotation: append "2:..." and run rotate_vault_keys.
SV_MFA_ENCRYPTION_KEYS=change-me
SV_VAULT_KEK_KEYS=change-me
SV_BLIND_INDEX_KEYS=change-me
# Production target: a KMS-backed KeyProvider instead of keys in the environment (see docs/known-limitations.md).
# SV_VAULT_KEY_PROVIDER=apps.vault.keys.EnvKeyProvider

# --- Optional features (off unless set) -------------------------------------------------------------------------
# Prometheus scrape token (32+ characters). Unset = /api/v1/metrics/ answers 404. Never routed through nginx.
# SV_METRICS_TOKEN=
# Swagger UI and /api/v1/schema/ (authenticated users only). The Swagger UI loads assets from a CDN, which the
# production Content-Security-Policy blocks; use docs/openapi.yaml instead unless you relax the policy.
# SV_ENABLE_API_DOCS=false
# SV_LOG_LEVEL=INFO

# --- Email (invitations, password resets) -----------------------------------------------------------------------
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_DEFAULT_FROM_EMAIL=SecureVault <no-reply@example.com>
